+			require(png.size >= 33 && pngSignature.indices.all { png[it] == pngSignature[it] } &&
+				png[12] == 'I'.code.toByte() && png[13] == 'H'.code.toByte() &&
+				png[14] == 'D'.code.toByte() && png[15] == 'R'.code.toByte()) {
