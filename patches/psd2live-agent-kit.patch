+	internal fun sampleEyeCurve(curve: SourceEyeCurve, x: Float): Float {
+		val points = curve.points
+		if (x <= points.first().first) return points.first().second
+		if (x >= points.last().first) return points.last().second
+		val right = points.indexOfFirst { it.first >= x }
+		val a = points[right - 1]; val b = points[right]
+		return a.second + (b.second - a.second) * ((x - a.first) / (b.first - a.first))
+	}
