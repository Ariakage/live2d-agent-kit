+/**
+ * Replaces texture pixels only after the rig has normalized UVs against the original atlas.
+ * Placements remain in the original packing coordinate system and must never be used to rebuild
+ * a rig against these enlarged pages. Both runtime sidecars and editable CMO3 consume the new
+ * page dimensions together with the unchanged normalized UVs.
+ */
+internal object TextureOverride {
+	private val pngSignature = byteArrayOf(0x89.toByte(), 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a)
+	private val sha256Pattern = Regex("[0-9a-fA-F]{64}")
+
+	fun apply(atlas: PackedAtlas, config: PipelineConfig): PackedAtlas {
+		val paths = config.exportTexturePages
+		val expectedHashes = config.exportTextureSourceSha256
+		if (paths.isEmpty() && expectedHashes.isEmpty()) return atlas
+		require(paths.size == atlas.pages.size && expectedHashes.size == atlas.pages.size) {
+			"Export texture paths and source SHA-256 values must each match the packed atlas page count (${atlas.pages.size})"
+		}
+		var commonScale = 0
+		val pages = atlas.pages.mapIndexed { index, source ->
+			require(atlas.packingPageSizes.getOrNull(index) == (source.image.width to source.image.height)) {
+				"Export texture overrides must be applied to original packed pages, before any enlargement"
+			}
+			val expectedHash = expectedHashes[index]
+			require(sha256Pattern.matches(expectedHash)) {
+				"Export texture source SHA-256 for page $index must contain exactly 64 hexadecimal characters"
+			}
+			val actualHash = MessageDigest.getInstance("SHA-256").digest(source.png)
+				.joinToString("") { "%02x".format(it.toInt() and 0xff) }
+			require(expectedHash.equals(actualHash, ignoreCase = true)) {
+				"Export texture page $index is stale: expected source SHA-256 $expectedHash, freshly packed atlas is $actualHash"
+			}
