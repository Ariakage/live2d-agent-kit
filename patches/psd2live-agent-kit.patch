+	internal fun closedEyeEndpointPoint(x: Float, y: Float, source: SourceEyeCorners, target: SourceEyeCorners): Pair<Float, Float> {
+		val sx = source.rightX - source.leftX
+		val sy = source.rightY - source.leftY
+		val tx = target.rightX - target.leftX
+		val ty = target.rightY - target.leftY
+		val denominator = sx * sx + sy * sy
+		val a = (tx * sx + ty * sy) / denominator
+		val b = (ty * sx - tx * sy) / denominator
+		val dx = x - source.leftX
+		val dy = y - source.leftY
+		return target.leftX + a * dx - b * dy to target.leftY + b * dx + a * dy
+	}
